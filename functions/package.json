{
  "name": "functions",
  "private": true,
  "description": "Cloud Functions for Hercule — server-side AI coach",
  "main": "dist/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "genkit:ui": "genkit start -- npx tsx --watch src/ai/index.ts",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.41.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "genkit": "^1.41.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "genkit-cli": "^1.41.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
