{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": [
        "./*"
      ],
      "firebase-admin/*": [
        "./functions/node_modules/firebase-admin/lib/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
, "plugins/ios/withFmtFix.js"  ],
  "exclude": [
    "node_modules",
    "functions"
  ]
}